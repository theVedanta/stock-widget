# Bearer token the iOS app sends. python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# --- Groww (Trade API subscription required) -------------------------------
# Recommended: API key + TOTP secret -> token renews itself every day.
GROWW_API_KEY=
GROWW_TOTP_SECRET=
# Alternatives:
# GROWW_API_SECRET=          # approval flow; approve the key daily on groww.in
# GROWW_ACCESS_TOKEN=        # paste a token by hand; expires 06:00 IST

# --- Interactive Brokers (via IB Gateway) ----------------------------------
IBKR_ENABLED=true
IBKR_USERNAME=               # used by the ib-gateway container only
IBKR_PASSWORD=
# IBKR_ACCOUNT=U1234567      # blank = first account on the login
# IBKR_MARKET_DATA_TYPE=4    # delayed-frozen if you have no market-data subscription

# --- Tuning -----------------------------------------------------------------
# CACHE_TTL_SECONDS=60
# REFRESH_SECONDS=300
# HISTORY_DAYS=30
